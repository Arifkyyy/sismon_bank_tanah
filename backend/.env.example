# Salin berkas ini menjadi ".env" lalu sesuaikan isinya.

# Alamat database PostgreSQL:
# postgresql+psycopg://NAMA_USER:SANDI@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql+psycopg://sismon:sismon123@localhost:5432/sismon_bank_tanah

# Kunci rahasia untuk menandatangani token login.
# WAJIB diganti dengan teks acak yang panjang. Buat dengan perintah:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Berapa menit token login berlaku (720 = 12 jam, satu shift).
JWT_MENIT=720

# Alamat frontend yang boleh memanggil API ini. Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Berapa hari ke belakang checklist harian masih boleh diisi petugas.
# 0 = hanya hari ini, 1 = hari ini dan kemarin.
CHECKLIST_MUNDUR_HARI=1

# Lama lembur paling panjang dalam satu penugasan (jam).
MAKS_JAM_LEMBUR=12

# Folder tempat foto bukti disimpan.
FOLDER_FOTO=uploads

# Alamat publik backend ini, dipakai untuk membuat link foto.
URL_PUBLIK=http://localhost:8000

# Cloudflare R2 untuk menyimpan foto online (dipakai bersama seluruh tim).
# Harus SAMA di semua laptop tim. Bila salah satu kosong, foto disimpan di
# FOLDER_FOTO lokal. Foto lama: jalankan "python pindah_foto_ke_r2.py".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Berapa menit link foto berlaku sebelum perlu dimuat ulang.
R2_URL_MENIT=720

# Kunci Web Push (VAPID) untuk notifikasi di HP/laptop walau aplikasi ditutup.
# Harus SAMA di semua laptop tim (database dipakai bersama) — minta ke anggota
# tim yang sudah punya; jangan buat pasangan baru sendiri. Kosongkan = push mati.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
