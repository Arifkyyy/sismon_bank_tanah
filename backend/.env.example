# Salin berkas ini menjadi ".env" lalu sesuaikan isinya.

# Alamat database PostgreSQL:
# postgresql+psycopg://NAMA_USER:SANDI@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql+psycopg://sismon:sismon123@localhost:5432/sismon_bank_tanah

# Kunci rahasia untuk menandatangani token login.
# WAJIB diganti dengan teks acak yang panjang. Buat dengan perintah:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Berapa menit token login berlaku (720 = 12 jam, satu shift).
JWT_MENIT=720

# Alamat frontend yang boleh memanggil API ini. Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Berapa hari ke belakang checklist harian masih boleh diisi petugas.
# 0 = hanya hari ini, 1 = hari ini dan kemarin.
CHECKLIST_MUNDUR_HARI=1

# Folder tempat foto bukti disimpan.
FOLDER_FOTO=uploads

# Alamat publik backend ini, dipakai untuk membuat link foto.
URL_PUBLIK=http://localhost:8000
